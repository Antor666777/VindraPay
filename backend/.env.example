# Application
APP_NAME=vindrapay-go
PORT=8080
# development | staging | production
APP_ENV=development

# Database (Postgres)
# postgres://<user>:<password>@<host>:<port>/<database>?sslmode=disable
DATABASE_URL=postgres://postgres:postgres@localhost:5432/vindrapay?sslmode=disable

# Rate limiting (verification attempts per business)
RATE_LIMIT_MAX_ATTEMPTS=10
RATE_LIMIT_WINDOW_SECONDS=60

# Management API (static bearer key; empty disables the /manage/v1 routes entirely)
MANAGEMENT_API_KEY=

# Custom logic scripting (per-provider JS run after SMS parsing)
# Wall-clock budget per script execution, clamped to 10..1000 ms.
SCRIPT_TIMEOUT_MS=100
# When false (default), scripts may not override trxId/balance; attempts are dropped and reported as ignored_unsafe.
ALLOW_UNSAFE_SCRIPTS=false
