# VindraPay Studio configuration.
# Copy to .env and uncomment what you need. Every value can also be passed
# as a CLI flag; precedence is FLAG > ENV > DEFAULT.

# Port the studio listens on (default 5175).
#STUDIO_PORT=5175

# Bind address. Keep 127.0.0.1 for local-only access; use 0.0.0.0 to expose
# the studio on your LAN (see README security notes first).
#STUDIO_HOST=127.0.0.1

# Base URL of the Go backend (default http://localhost:8080).
#STUDIO_BACKEND_URL=http://localhost:8080

# REQUIRED. Same value as the backend's MANAGEMENT_API_KEY in backend/.env.
#STUDIO_API_KEY=

# Optional UI login gate. Leave unset to disable the password screen entirely.
#STUDIO_AUTH_PASSWORD=

# Backend request timeout in ms, clamped to 1000..120000 (default 10000).
#STUDIO_TIMEOUT_MS=10000
